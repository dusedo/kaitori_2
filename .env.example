# Copy to .env.local and fill in. Both Node and Python monitors read this file.

# Comma-separated list of product URLs to watch.
WATCH_URLS=https://joshinweb.jp/camera/72620/4547410555172.html

# Polling interval in seconds (per URL). Real value gets ±25% jitter.
# Stay above 60s to avoid behavioral 403s. 90-120s is a safer default.
POLL_INTERVAL_SEC=90

# Discord webhook for stock-revival notifications.
DISCORD_WEBHOOK_URL=

# Optional: LINE Messaging API channel access token + user/group ID.
# Leave blank to skip LINE. (LINE Notify is shut down as of 2025.)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
